{
  "name": "node-red-contrib-nuki",
  "version": "1.1.0",
  "description": "Interact with your nuki bridge locally",
  "license": "MIT",
  "keywords": [
    "node-red",
    "nuki",
    "nuki-bridge",
    "smarthome"
  ],
  "node-red": {
    "nodes": {
      "nuki": "nuki/nuki.js"
    }
  },
  "dependencies": {
    "nuki-bridge-api": "^1.8.0",
    "nuki-web-api": "^2.2.1"
  },
  "devDependencies": {
    "assert": "^2.1.0",
    "babel-eslint": "^10.1.0",
    "eslint": "^9.3.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-standard": "^4.1.0",
    "mocha": "^11.7.1",
    "npm-check": "^6.0.1",
    "prettier": "^3.6.2",

    "proxyquire": "^2.1.3",
    "sinon": "^21.0.0"
  },
  "scripts": {
    "test": "mocha --sort --exit --timeout 5000 test/**/*.js",
    "lint:fix": "eslint --fix nuki/**.js",
    "lint": "eslint nuki/**.js",
    "eslint:github-action": "eslint nuki/**.js",
    "fmt": "prettier --write **/*.{js,yml}",
    "fmt:check": "prettier --check **/*.{js,yml}"
  },
  "repository": "mabunixda/node-red-contrib-nuki"
}
